# Copy to .env.local and fill in. On Vercel these come from
# Settings → Environment Variables (the Supabase integration adds the
# SUPABASE_* ones by itself).

# ---- Live reviews (browser) — public values, safe in the site's code ----
# Supabase → Project Settings → API: Project URL + the publishable/anon key.
# Empty = the reviews section stays hidden.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Contact brief (server only: api/brief.js) — never prefix with VITE_ ----
# Briefs are saved in the `briefs` table (run supabase/briefs.sql once).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Email notification for each new brief, via https://resend.com (free tier).
# Optional: without it briefs are still saved — read them in Supabase.
RESEND_API_KEY=
# Optional overrides
# BRIEF_TO_EMAIL=official.ahmedabdullah@gmail.com
# BRIEF_FROM_EMAIL=Design Dynamo <hello@designdynamo.art>   (domain verified in Resend)

# Dev only: try the reviews flow without Supabase (starts empty, your own
# test reviews get "approved" after a few seconds). Ignored in builds.
# VITE_REVIEWS_MOCK=true
