# Copy to .env.local and fill in.

# Contact form — free key from https://web3forms.com (enter
# official.ahmedabdullah@gmail.com; the key is emailed to you).
# Empty = the form falls back to opening the visitor's mail app.
VITE_WEB3FORMS_KEY=

# Live reviews — from your Supabase project: Settings → API
# (Project URL and the "anon public" key). Run supabase/reviews.sql first.
# Empty = the reviews section stays hidden.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev only: try the reviews flow without Supabase (starts empty, your own
# test reviews get "approved" after a few seconds). Ignored in builds.
# VITE_REVIEWS_MOCK=true
